# ── Nova Legal OS — Environment Variables ──────────────────────────
# Copy this file to .env and fill in your values.

# ── LLM Configuration ─────────────────────────────────────────────
# Option A: Local Ollama (default — runs your fine-tuned NoveLaw model)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=novelaw

# Option B: NVIDIA NIM (cloud API — used only for dataset generation)
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=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
NVIDIA_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2

# ── Paths ─────────────────────────────────────────────────────────
# All paths default to relative locations under Indian Legal/
# Uncomment and change only if your layout differs.
# INDIAN_LEGAL_DIR=D:\Nova Legal\Indian Legal
# RAW_DIR=D:\Nova Legal\Indian Legal\raw
# CORPUS_DIR=D:\Nova Legal\Indian Legal\processed_corpus
# INDEX_DIR=D:\Nova Legal\Indian Legal\nova_rag_index
# CATEGORY_DIR=D:\Nova Legal\Indian Legal\Category

# ── OCR (optional) ───────────────────────────────────────────────
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# OCR_LANGUAGE=eng

# ── Server ────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
